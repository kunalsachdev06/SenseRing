        </service>
        <service android:name=".ModernRingPresenceService" tools:targetApi="36" android:enabled="@bool/modern_presence" android:exported="true" android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter><action android:name="android.companion.CompanionDeviceService"/></intent-filter>
        </service>
    </application>
</manifest>
